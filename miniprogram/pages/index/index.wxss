.container {
  padding-bottom: 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 顶部标题 */
.hd {
  padding: 30rpx 30rpx 10rpx;
}
.hd-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.hd-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  flex-shrink: 0;
}
.hd-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 右上角筛选：城市 / 快闪类型 单选下拉 */
.filters {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.filter-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  background: #fff;
  border: 1rpx solid #e6e2f5;
  border-radius: 30rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, .04);
}
.filter-pill:active {
  background: #f6f3ff;
}
.filter-text {
  font-size: 24rpx;
  color: #6C5CE7;
  max-width: 170rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filter-arrow {
  font-size: 18rpx;
  color: #6C5CE7;
  line-height: 1;
}

/* 月历卡片 */
.cal {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .06);
}
.cal-hd {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  position: relative;
  margin-bottom: 16rpx;
}
.cal-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.cal-nav {
  font-size: 44rpx;
  color: #6C5CE7;
  padding: 0 16rpx;
}
.cal-nav.disabled {
  color: #ccc;
  pointer-events: none;
}
.cal-today {
  position: absolute;
  right: 0;
  font-size: 24rpx;
  color: #6C5CE7;
  padding: 6rpx 16rpx;
  background: #f0e8ff;
  border-radius: 24rpx;
}

.cal-week {
  display: flex;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0;
}

/* 每周行：相对定位，给持续线做参考；高度由 inline style 动态设置 */
.cal-weekrow {
  display: flex;
  position: relative;
}

/* 日期格子 */
.cal-cell {
  flex: 1;
  height: 110rpx;
  position: relative;
  box-sizing: border-box;
}
.cal-day {
  margin: 4rpx;
  width: calc(100% - 8rpx);
  height: calc(100% - 8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  position: relative;
  box-sizing: border-box;
}
.cal-day.empty {
  background: transparent;
}
.cal-day.out {
  opacity: .35;
}
.cal-num {
  font-size: 26rpx;
  color: #333;
  z-index: 2;
  position: relative;
}
.cal-day.today {
  background: rgba(108, 92, 231, .14);
}
.cal-day.today .cal-num {
  color: #6C5CE7;
  font-weight: bold;
}
.cal-day.evt {
  background: rgba(108, 92, 231, .04);
}

/* 选中边框环 */
.cal-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 4rpx solid;
  border-radius: 12rpx;
  z-index: 3;
  pointer-events: none;
}

/* 持续线容器：覆盖整周行，与 7 个格子边界对齐 */
.cal-bars {
  position: absolute;
  top: 56rpx;
  left: 0;
  right: 0;
  bottom: 8rpx;
  z-index: 1;
  pointer-events: none;
}
.cal-bar {
  position: absolute;
  height: 18rpx;
  border-radius: 9rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,.12);
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.cal-bar-title {
  font-size: 18rpx;
  color: #fff;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  padding: 0 8rpx;
}

/* 选中日期提示 */
.selbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 6rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .06);
}
.sel-clear {
  color: #6C5CE7;
  font-size: 24rpx;
}

/* 列表 */
.section-head {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 24rpx 8rpx;
}
.store-list {
  padding: 10rpx 24rpx;
}
.store-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .06);
}
.card-img {
  width: 200rpx;
  height: 200rpx;
  background: #eee;
  flex-shrink: 0;
}
.card-img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #fff;
  background: linear-gradient(135deg, #a18cd1, #fbc2eb);
}
.card-info {
  padding: 20rpx 24rpx;
  flex: 1;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.card-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
.card-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.card-date {
  font-size: 22rpx;
  color: #888;
}
.card-type {
  font-size: 20rpx;
  color: #6C5CE7;
  background: #f0e8ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.load-more, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
.empty-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #bbb;
}
