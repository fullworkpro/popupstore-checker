.container {
  padding-bottom: 120rpx;
}

.img-swiper {
  width: 100%;
  height: 1000rpx;
  background: #f2f2f2;
}
.swiper-img {
  width: 100%;
  height: 100%;
  background: #f2f2f2;
}
.hero-img {
  width: 100%;
  height: 1000rpx;
  background: #f2f2f2;
}

/* 全屏看图 */
.img-viewer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, .92);
  z-index: 999;
}
.viewer-area {
  width: 100vw;
  height: 100vh;
}
.viewer-box {
  width: 100%;
  height: 100%;
}
.viewer-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.viewer-img {
  width: 100%;
}
.viewer-tip {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, .7);
  font-size: 24rpx;
}
.hero-placeholder {
  width: 100%;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #a18cd1, #fbc2eb);
  font-size: 80rpx;
}

.content {
  padding: 30rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
}
.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  padding: 6rpx 20rpx;
  background: #f0e8ff;
  color: #6C5CE7;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.info-card {
  margin-top: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.info-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.desc-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}
.desc-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.stats {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #aaa;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
}
.fav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: #f0e8ff;
  color: #6C5CE7;
  font-size: 28rpx;
  border: 1rpx solid #d9c8ff;
}
.fav-btn.active {
  background: #6C5CE7;
  color: #fff;
  border-color: #6C5CE7;
}
.fav-icon {
  font-size: 32rpx;
}
.share-inner {
  flex: 1;
  background: #6C5CE7;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
}
