.container {
  padding-bottom: 20rpx;
}

/* 搜索 */
.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input {
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
}

/* 标签栏 */
.tag-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.tag-item {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: #f0f0f0;
  font-size: 24rpx;
  color: #666;
}
.tag-item.active {
  background: #6C5CE7;
  color: #fff;
}

/* 排序 */
.sort-bar {
  display: flex;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.sort-item {
  margin-right: 40rpx;
  font-size: 26rpx;
  color: #999;
}
.sort-item.active {
  color: #6C5CE7;
  font-weight: bold;
}

.store-list {
  padding: 20rpx 24rpx;
}
.store-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}
.card-img {
  width: 100%;
  height: 320rpx;
  background: #eee;
}
.card-img--empty {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #a18cd1, #fbc2eb);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #fff;
}
.card-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.tag {
  padding: 4rpx 16rpx;
  background: #f0e8ff;
  color: #6C5CE7;
  font-size: 20rpx;
  border-radius: 8rpx;
}
.card-info {
  padding: 20rpx 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.card-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
.card-meta {
  margin-top: 12rpx;
  display: flex;
  gap: 24rpx;
}
.card-city, .card-views {
  font-size: 22rpx;
  color: #888;
}
.load-more, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
