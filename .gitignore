__pycache__/
*.py[cod]
*.db
# 改库前的安全备份（如 popstore.db.bak-20260910-010426），不入库
*.db.bak-*
*.bak-*
.env
venv/
node_modules/
dist/
.DS_Store
data/uploads/*
!data/uploads/.gitkeep
*.log
*.zip
popstore-docker.zip

# 策展导入 inbox：只保留 README 契约说明，抓取产物 JSON 不入库
backend/data/inbox/*.json
popstore-docker/backend/data/inbox/*.json
backend/data/inbox/done/*
!backend/data/inbox/done/.gitkeep

# 本地工作记忆（含项目 memory），不入库、不泄露到公开仓库
.workbuddy/
